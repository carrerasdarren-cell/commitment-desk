# Verified model and region for Commitment Desk.
MODEL_PROVIDER=bedrock
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Hosted values belong in server-side Sites secrets. For local development,
# use an ignored .env file or the standard AWS SDK credential chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional local Ollama development (full sample has not passed with this model).
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=commitment-desk-qwen
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/

# Keep owner mode behind owner-only hosting access. Production without an
# explicit mode disables live reviews. Never use owner mode on a public site.
LIVE_ACCESS_MODE=owner

# Protected judge mode additionally requires a migrated D1 DB binding.
# LIVE_ACCESS_MODE=judge
# JUDGE_ACCESS_CODE=   # Server secret; use a random 24-256 character value.
# JUDGE_ACCESS_EXPIRES_AT=2026-10-09T00:00:00Z
# JUDGE_REVIEW_LIMIT=  # Shared total of admitted starts, including failures.
# Limits are not dollar caps. Zero/missing/invalid settings disable access.
