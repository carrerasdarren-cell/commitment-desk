# Verified model and region for Commitment Desk.
MODEL_PROVIDER=bedrock
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Hosted values belong in server-side Sites secrets. For local development,
# use an ignored .env file or the standard AWS SDK credential chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional local Ollama development (full sample has not passed with this model).
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=commitment-desk-qwen
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/
